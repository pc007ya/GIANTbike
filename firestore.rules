rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && request.auth.token.email.lower() in ['pc007ya@gmail.com'];
    }

    function validAccount(data) {
      return data.keys().hasOnly(['email', 'vendorId', 'enabled'])
        && data.email is string
        && data.email.size() <= 320
        && data.email.lower() == data.email
        && data.email.matches('^[^ @]+@[^ @]+[.][^ @]+$')
        && !(data.email in ['pc007ya@gmail.com'])
        && data.vendorId is string
        && data.vendorId.matches('^[a-z0-9][a-z0-9_-]{0,63}$')
        && !(data.vendorId in ['admin', 'anon', 'anonymous'])
        && data.enabled is bool;
    }

    function verifiedEmail() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email is string;
    }

    function passwordSignIn() {
      return request.auth.token.firebase.sign_in_provider == 'password';
    }

    function supportedProvider() {
      return passwordSignIn() || request.auth.token.firebase.sign_in_provider == 'google.com';
    }

    function activeAccount(data) {
      return validAccount(data) && data.enabled == true
        && data.email == request.auth.token.email.lower();
    }

    function supplierRecord() {
      return get(/databases/$(database)/documents/bff_supplierAccounts/$(request.auth.uid)).data;
    }

    function googleSubject() {
      return request.auth.token.firebase.identities['google.com'][0];
    }

    function googleApproved() {
      return request.auth.token.firebase.sign_in_provider == 'google.com'
        && googleSubject() is string
        && get(/databases/$(database)/documents/bff_googleLinks/$(request.auth.uid)).data.googleSub == googleSubject();
    }

    function approvedLogin() {
      return passwordSignIn() || googleApproved();
    }

    function isSupplier() {
      return verifiedEmail() && supportedProvider() && activeAccount(supplierRecord()) && approvedLogin();
    }

    function owns(vendorId) {
      return isSupplier() && supplierRecord().vendorId == vendorId;
    }

    function recentPassword() {
      return passwordSignIn()
        && request.auth.token.auth_time is int
        && request.auth.token.auth_time * 1000 <= request.time.toMillis()
        && request.auth.token.auth_time * 1000 >= request.time.toMillis() - 300000;
    }

    match /bff_supplierAccounts/{uid} {
      allow get: if isAdmin() || (verifiedEmail() && request.auth.uid == uid
        && supportedProvider() && activeAccount(resource.data) && approvedLogin());
      allow list: if isAdmin();
      allow create: if isAdmin() && validAccount(request.resource.data);
      allow update: if isAdmin() && validAccount(request.resource.data)
        && request.resource.data.email == resource.data.email
        && request.resource.data.vendorId == resource.data.vendorId;
      allow delete: if false;
    }

    match /bff_googleLinks/{uid} {
      allow get: if isAdmin() || (request.auth != null && request.auth.uid == uid && isSupplier());
      allow list: if isAdmin();
      allow create: if verifiedEmail() && request.auth.uid == uid && recentPassword()
        && activeAccount(supplierRecord())
        && request.resource.data.keys().hasOnly(['googleSub'])
        && googleSubject() is string
        && request.resource.data.googleSub == googleSubject();
      allow delete: if isAdmin();
    }

    match /bff/{docId} {
      allow read, write: if isAdmin();
    }

    match /bff_catalog/{docId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    function activeProjectChunk(vendorId, chunk) {
      let current = get(/databases/$(database)/documents/bff_vendorProjects/$(vendorId)).data;
      return current.chunked == true && chunk._rev == current._rev
        && chunk.i is int && chunk.i >= 0 && chunk.i < current.chunks;
    }

    match /bff_vendorProjects/{vendorId} {
      allow read: if isAdmin() || owns(vendorId);
      allow write: if isAdmin();
      match /chunks/{chunkId} {
        // Only the active version is readable; leftovers from a larger old
        // projection must not disclose a removed assignment.
        allow read: if isAdmin() || (owns(vendorId) && activeProjectChunk(vendorId, resource.data));
        allow write: if isAdmin();
      }
    }

    match /bff_stock/{vendorId} {
      allow read, create, update: if isAdmin() || owns(vendorId);
      allow delete: if isAdmin();
    }

    match /bff_report/{vendorId} {
      allow read, create, update: if isAdmin() || owns(vendorId);
      allow delete: if isAdmin();
    }

    match /bff_stepphoto/{vendorId} {
      allow read, create, update: if isAdmin() || owns(vendorId);
      allow delete: if isAdmin();
    }

    match /bff_loginlog/{vendorId} {
      allow read, write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
