rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && request.auth.token.email.lower() in ['pc007ya@gmail.com'];
    }

    function okImage() {
      return request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('^image/(jpeg|png|webp)$');
    }

    // Storage remains disabled by the app. These rules do not enable a bucket,
    // move images onto Firebase, or replace GitHub Pages public media.
    match /catalog/{allPaths=**} {
      allow read: if isAdmin();
      allow create, update: if isAdmin() && okImage();
      allow delete: if isAdmin();
    }

    match /vendors/{vendorId}/{allPaths=**} {
      allow read: if isAdmin();
      allow create, update: if isAdmin() && okImage();
      allow delete: if isAdmin();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
